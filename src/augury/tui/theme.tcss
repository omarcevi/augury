Screen { layout: vertical; }
#health { height: 3; border: round $primary; padding: 0 1; }
#health { text-wrap: nowrap; text-overflow: ellipsis; }  /* one line, clipped with … */
#views { height: 1fr; }
#main { height: 1fr; }
#items-pane { border: round $primary; border-title-color: $accent; height: 1fr; }
#items { height: 1fr; }
#empty { padding: 1 2; color: $text-muted; }
#banner { display: none; height: 1; padding: 0 1; color: $warning; text-wrap: nowrap; text-overflow: ellipsis; }
#triage-hidden { display: none; height: 1; padding: 0 1; color: $text-muted; text-wrap: nowrap; text-overflow: ellipsis; }
#status { height: 2; padding: 0 1; text-wrap: nowrap; text-overflow: ellipsis; }
HelpOverlay { align: center middle; }
#help-body { width: 64; height: auto; max-height: 90%; border: round $accent; border-title-color: $accent; border-subtitle-color: $text-muted; background: $surface; padding: 0 2; }
#filters { height: 3; }
#search { width: 1fr; min-width: 7; }
.chip { width: auto; min-width: 14; max-width: 24; height: 3; border: round $primary; border-title-color: $text-muted; padding: 0 1; text-wrap: nowrap; text-overflow: ellipsis; }
/* The filter row fits the screen from 80 columns. Below 160 there's no room for the Theme chip
   (`t` still cycles it and names the theme in a toast; help lists the key). Below 100 the Sources
   chip stays at its title's width (a long source name ends in …), so at 80 the chips take 73 and
   the search box 7: while it has focus it takes the whole row instead (the chips move off it),
   and the Items title shows the query (AuguryApp.show_items_title). */
Screen.layout-medium #chip-theme, Screen.layout-narrow #chip-theme { display: none; }
Screen.layout-narrow #chip-sources { max-width: 17; }
Screen.layout-narrow #search { padding: 0 1; }
Screen.layout-narrow #search:focus { width: 100%; }
/* F27: the Tags chip needs room too. Below 100 columns it hides (# still opens the picker), and
   from 100 to 159 Sources and Tags stop at 17 (their longest values end in …): at 100 the row is
   then 7 + 17 + 4×14 + 17 = 97. */
Screen.layout-narrow #chip-tags { display: none; }
Screen.layout-medium #chip-sources, Screen.layout-medium #chip-tags { max-width: 17; }
PickerModal, ChoiceModal { align: center middle; }
#picker, #choice { width: 60; height: auto; max-height: 70%; border: round $accent; }
#main { layout: horizontal; }
#items-pane { width: 55%; }
#reader { width: 45%; border: round $primary; padding: 0 1; }
#reader-header { height: auto; }
#reader-status { height: auto; }
/* F28: up to half the reader; a longer TL;DR scrolls inside the box (the scrollbar says so). */
#reader-tldr-box { display: none; height: auto; max-height: 50%; overflow-y: auto; scrollbar-size-vertical: 1; border: round $accent; border-title-color: $accent; padding: 0 1; }
#reader-tldr { height: auto; }
/* P12: collapsed (h), the box holds one line that never wraps onto a second. */
#reader-tldr.collapsed { text-wrap: nowrap; text-overflow: ellipsis; }
#reader-doc { height: 1fr; }
/* P10: the text column is capped at [tui] reading_width (ReaderPane.set_reading_width); centre it. */
#reader-doc { align-horizontal: center; }
/* The contents tree is width: auto; long paper headings would squeeze the text to nothing. */
#reader-doc > MarkdownTableOfContents { max-width: 40%; }
Screen.layout-narrow #reader { display: none; }
Screen.layout-narrow #items-pane { width: 100%; }
Screen.layout-narrow.reading #items-pane { display: none; }
Screen.layout-narrow.reading #reader { display: block; width: 100%; }
Screen.zen #items-pane { display: none; }
Screen.zen #reader { width: 100%; }
#sources-view { layout: horizontal; height: 1fr; }
#sources-table { width: 55%; border: round $primary; }
#sources-side { width: 45%; border: round $primary; padding: 0 1; }
#add-url { margin-bottom: 1; }
#add-candidates { height: 1fr; }
/* M3: the discovery panel (progress lines, then the candidate checklist) */
#discovery-status { margin-bottom: 1; }
#discovery-progress { height: auto; max-height: 12; color: $text-muted; }
#discovery-candidates { height: 1fr; }
ConfirmModal { align: center middle; }
#confirm-body { width: 60; height: auto; border: round $warning; background: $surface; padding: 1 2; }
#config-view { height: 1fr; border: round $primary; padding: 0 1; }
/* P14: the settings table is part of the page's one scroll (ConfigView keeps its cursor in view),
   so it's as tall as its rows: a DataTable otherwise stops at its container's height. */
#settings { height: auto; max-height: 1000; }
#config-text { margin-top: 1; }
InputModal { align: center middle; }
#input-box { width: 64; height: auto; border: round $accent; border-title-color: $accent; border-subtitle-color: $text-muted; background: $surface; padding: 0 1; }
#input-hint { color: $text-muted; }
#input-error { color: $error; }
